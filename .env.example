# GEMINI_API_KEY: Required for Gemini AI API calls (TTS operational briefings).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Optional signing secret for session tokens (defaults to secure runtime key if omitted).
JWT_SECRET=""

# MONGODB_URI: Optional MongoDB connection string for external MongoDB deployment.
MONGODB_URI=""

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for live fleet tracking.
VITE_GOOGLE_MAPS_API_KEY=""

# Optional Live RTO / Vahan RC Verification API (e.g. API Setu, Surepass, Sandbox, Cashfree, RapidAPI)
RTO_API_URL=""
RTO_API_KEY=""
RTO_API_SECRET=""
RTO_API_HOST=""
RTO_API_METHOD=""

